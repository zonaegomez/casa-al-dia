rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() {
   return request.auth != null
    && request.auth.token.firebase.sign_in_provider != 'anonymous'
    && exists(/databases/$(database)/documents/access/$(request.auth.uid))
    && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.enabled == true;
  }
  function admin() { return member() && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role == 'admin'; }
  function actor() { return member() && request.resource.data.updatedBy == request.auth.uid; }
  function nonnegative(n) { return n is number && n >= 0 && n < 100000000; }
  function validDate(d) { return d is string && d.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
  function config() {return get(/databases/$(database)/documents/settings/config).data;}
  function day() {return exists(/databases/$(database)/documents/settings/config) ? config().get('cycleStartDay',1) : 1;}
  function previousMonth(d) {
   let m=int(d[5:7]);let y=int(d[0:4]);let prev=m==1?12:m-1;
   return string(m==1?y-1:y)+'-'+(prev<10?'0':'')+string(prev);
  }
  function cycle(d) {return int(d[8:10]) < day() ? previousMonth(d) : d[0:7];}
  function open(d) {return validDate(d) && !exists(/databases/$(database)/documents/closedCycles/$(cycle(d)));}
  function revision() {
   let before=exists(/databases/$(database)/documents/settings/config)?config().get('revision',0):0;
   return getAfter(/databases/$(database)/documents/settings/config).data.revision == before+1;
  }
  function receiptOpen(d) {return !d.keys().hasAny(['receiptId']) || (existsAfter(/databases/$(database)/documents/billReceipts/$(d.receiptId)) && open(getAfter(/databases/$(database)/documents/billReceipts/$(d.receiptId)).data.dueDate));}
  function participants(d) {return d.participantIds is list && d.participantIds.size()>0 && d.participantIds.size()<=50;}
  match /access/{uid} {allow get: if request.auth!=null && request.auth.uid==uid;allow list,write: if false;}
  match /settings/{id} {
   allow read: if member();
   allow create: if id=='config' && actor() && request.resource.data.cycleStartDay is int && request.resource.data.cycleStartDay>=1 && request.resource.data.cycleStartDay<=28 && request.resource.data.currency=='MXN';
   allow update: if id=='config' && actor()
    && request.resource.data.cycleStartDay==resource.data.cycleStartDay
    && (!resource.data.keys().hasAny(['legacyParticipantIds']) || request.resource.data.legacyParticipantIds==resource.data.legacyParticipantIds)
    && (admin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision','legacyParticipantIds','schemaVersion','updatedBy']));
   allow delete: if false;
  }
  match /members/{id} {
   allow read: if member();
   allow create,update: if actor() && revision() && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120;
   allow delete: if false;
  }
  match /items/{id} {
   allow read: if member();
   allow create,update: if actor() && nonnegative(request.resource.data.currentQty) && nonnegative(request.resource.data.minQty) && request.resource.data.name is string && request.resource.data.name.size()>0;
   allow delete: if false;
  }
  match /purchases/{id} {
   allow read: if member();
   allow create: if actor() && revision() && open(request.resource.data.date) && participants(request.resource.data) && nonnegative(request.resource.data.total) && request.resource.data.lineIds is list && request.resource.data.lineIds.size()<=100;
   allow update: if actor() && revision() && open(resource.data.date) && open(request.resource.data.date) && request.resource.data.lineIds==resource.data.lineIds && nonnegative(request.resource.data.total);
   allow delete: if false;
  }
  match /movements/{id} {
   allow read: if member();
   allow create: if actor() && revision() && open(request.resource.data.date) && participants(request.resource.data)
    && request.resource.data.type in ['compra','consumo'] && request.resource.data.qty is number && request.resource.data.qty>0
    && nonnegative(request.resource.data.total) ;
   allow update: if actor() && revision() && open(resource.data.date) && open(request.resource.data.date)
    && participants(request.resource.data) && nonnegative(request.resource.data.total)
    && request.resource.data.type==resource.data.type && request.resource.data.itemId==resource.data.itemId && request.resource.data.qty==resource.data.qty;
   allow delete: if false;
  }
  match /bills/{id} {
   allow read: if member();
   allow create: if actor() && revision() && request.resource.data.history==[] && nonnegative(request.resource.data.amountEstimate) && validDate(request.resource.data.nextDueDate);
   allow update: if actor() && revision() && request.resource.data.get('history',[])==resource.data.get('history',[]) && nonnegative(request.resource.data.amountEstimate) && validDate(request.resource.data.nextDueDate);
   allow delete: if false;
  }
  match /billReceipts/{id} {
   allow read: if member();
   allow create: if actor() && revision() && open(request.resource.data.dueDate) && participants(request.resource.data) && request.resource.data.amount is number && request.resource.data.amount>0 && request.resource.data.beneficiaryShares is list && request.resource.data.billId is string;
   allow update,delete: if false;
  }
  match /billPayments/{id} {
   allow read: if member();
   allow create: if actor() && revision() && receiptOpen(request.resource.data) && open(request.resource.data.paidAt) && participants(request.resource.data) && request.resource.data.amount is number && request.resource.data.amount>0 && request.resource.data.amount<100000000 && request.resource.data.billId is string;
   allow update: if actor() && revision() && receiptOpen(resource.data) && receiptOpen(request.resource.data) && open(resource.data.paidAt) && open(request.resource.data.paidAt) && participants(request.resource.data) && request.resource.data.billId==resource.data.billId && request.resource.data.amount is number && request.resource.data.amount>0 && request.resource.data.amount<100000000;
   allow delete: if false;
  }
  match /settlements/{id} {
   allow read: if member();
   allow create: if false; // Creation is reconciled in /api/settle.
   allow update: if actor() && revision() && resource.data.keys().hasAny(['allocationDate']) && open(resource.data.allocationDate) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided','updatedBy']);
   allow delete: if false;
  }
  match /debts/{id} {
   allow read: if member();
   allow create,update: if actor() && revision() && request.resource.data.fromId!=request.resource.data.toId && nonnegative(request.resource.data.totalAmount) && request.resource.data.totalAmount>0 && request.resource.data.payments is list && request.resource.data.payments.size()<=1000;
   allow delete: if false;
  }
  match /reminders/{id} {allow read: if member();allow create,update: if actor() && request.resource.data.title is string && validDate(request.resource.data.dueDate);allow delete: if member();}
  match /closedCycles/{id} {allow read: if member();allow write: if false;}
  match /operations/{id} {allow read: if member();allow create: if member() && request.resource.data.actorUid==request.auth.uid && request.resource.data.paths is list && request.resource.data.paths.size()<=250;allow update,delete: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
